{
  "name": "christmas-tree-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 4173",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build-web.mjs",
    "build:toss": "npm run build && ait build",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply podomoa-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply podomoa-db --remote"
  },
  "version": "0.1.0",
  "dependencies": {
    "@apps-in-toss/web-framework": "3.7.0"
  },
  "devDependencies": {
    "wrangler": "^4.151.0",
    "esbuild": "0.28.2"
  }
}
