{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "treemoa",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "podomoa-db",
      "database_id": "8a232a2e-424c-45cc-a132-eae0e884fcef",
      "migrations_dir": "migrations/tree",
      "migrations_table": "tree_d1_migrations"
    }
  ],
  "vars": {
    "BANNER_AD_GROUP_ID": "ait.v2.live.6bb7c956ef414267",
    "REWARDED_AD_GROUP_ID_1": "ait.v2.live.7a6ea91e858a4b06",
    "REWARDED_AD_GROUP_ID_2": "2",
    "REWARDED_AD_GROUP_ID_3": "3",
    "REWARDED_AD_GROUP_ID_4": "4",
    "REWARDED_AD_GROUP_ID_5": "5",
    "TOSS_PROMOTION_AMOUNT_DAY_15": "50",
    "TOSS_PROMOTION_AMOUNT_DAY_30": "50",
    "TOSS_PROMOTION_MODE": "live"
  }
}
