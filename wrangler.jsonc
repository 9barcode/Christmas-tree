{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "treemoa",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "mtls_certificates": [
    { "binding": "TOSS_MTLS", "certificate_id": "01f9a44c-aa13-4296-a12c-abd239616c81" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "podomoa-db",
      "database_id": "8a232a2e-424c-45cc-a132-eae0e884fcef",
      "migrations_dir": "migrations/treemoa",
      "migrations_table": "treemoa_d1_migrations"
    }
  ]
}
